# we do not commit Virtual Environment
.venv/

# we do not commit local VSCode or other IDE stuff
.vscode/
.idea/

# do not commit generated info
src/*.egg-info/
# also no caches
*__pycache__*
.pytest_cache

# exclude things to be committed from local_workfolder
local_workfolder/data/*
local_workfolder/logs/*
local_workfolder/tmp/*